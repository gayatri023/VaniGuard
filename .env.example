# Copy this file to `.env` in the repo root (VS Code: File > New File, paste, save as .env). It is loaded
# automatically; real environment variables still win. .env is gitignored: NEVER commit it, NEVER paste a key in chat.
# --- API (apps/api) ---
VANI_DEV=0                      # 1 = local dev: simulator allowed, /docs on, debug payload, default admin token. NEVER 1 in production
VANI_MODEL_BACKEND=gemini       # gemini | fake (fake only with VANI_DEV=1)
GEMINI_API_KEY=
GEMINI_MODEL=                   # pin the exact string from AI Studio; config/pricing.yaml model must match
GEMINI_THINKING_BUDGET=         # optional; only sent if set
DATABASE_URL=sqlite:///./vani.db   # production: postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
ADMIN_TOKEN=                    # at least 16 random characters (required in live mode)
ALLOWED_ORIGINS=http://localhost:3000
DAILY_COST_CAP_USD=
SESSION_COST_CAP_USD=
MAX_COMMANDS_PER_SESSION=40
ARMS_ENABLED=0                  # 1 = randomise routed vs always-confirm per card
PROBES_ENABLED=0                # 1 = seeded-error probes (consent text discloses them automatically)
PROBE_RATE=0.10
MAX_PROBES_PER_SESSION=2
STUDY_PAUSED=0                  # 1 = kill switch
TRUST_PROXY=0                   # 1 behind Render/Vercel-style proxies so rate limits see the client address
RATE_PER_IP_PER_MIN=120
RATE_PER_SESSION_PER_MIN=20
APP_VERSION=0.1.0
# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEV=0               # 1 only locally: dev simulator panel and /dev/states
